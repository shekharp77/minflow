{
  "name": "@shekharsingh/minflow",
  "version": "0.1.0",
  "description": "A React component library in one minimalist design language. Tokens, motion and accessibility audited as a system.",
  "license": "Apache-2.0",
  "homepage": "https://minflow.design",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shekharp77/minflow.git"
  },
  "bugs": {
    "url": "https://github.com/shekharp77/minflow/issues"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "design-system",
    "tailwind",
    "minimalist",
    "shadcn"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    },
    "./*": {
      "types": "./dist/ui/*.d.ts",
      "default": "./dist/ui/*.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm registry:build && next build",
    "typecheck": "next typegen && tsc --noEmit",
    "registry:build": "node scripts/build-registry.mjs && shadcn build",
    "registry:validate": "shadcn registry validate",
    "package:build": "node scripts/build-package.mjs",
    "package:check": "node scripts/check-package.mjs",
    "preview": "serve out -l 3000"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lenis": "^1.3.26",
    "lucide-react": "^1.34.0",
    "motion": "^13.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "serve": "^14.2.6",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@9.15.9"
}
