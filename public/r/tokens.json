{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "tokens",
  "title": "Token layer",
  "description": "Every colour, size, radius and duration the library styles itself through. Install this before any component.",
  "dependencies": [
    "motion",
    "@formkit/auto-animate",
    "lucide-react",
    "clsx",
    "tailwind-merge",
    "class-variance-authority"
  ],
  "cssVars": {
    "theme": {
      "color-bg": "var(--bg)",
      "color-bg-2": "var(--bg-2)",
      "color-fg": "var(--fg)",
      "color-fg-2": "var(--fg-2)",
      "color-text": "var(--text)",
      "color-text-2": "var(--text-2)",
      "color-accent": "var(--accent)",
      "color-on-accent": "var(--on-accent)",
      "color-border": "var(--border)",
      "color-border-strong": "var(--border-strong)",
      "color-control-edge": "var(--control-edge)",
      "color-hover": "var(--hover)",
      "color-stage": "var(--stage)",
      "color-ok": "var(--ok)",
      "color-warn": "var(--warn)",
      "color-err": "var(--err)",
      "color-id-1": "var(--id-1)",
      "color-id-2": "var(--id-2)",
      "color-id-3": "var(--id-3)",
      "font-sans": "\"Inter Variable\", ui-sans-serif, system-ui, sans-serif",
      "font-display": "\"Nunito Variable\", \"Inter Variable\", ui-sans-serif, sans-serif",
      "font-mono": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace",
      "shadow-overlay": "var(--overlay-shadow)",
      "radius-control": "6px",
      "radius-overlay": "10px",
      "z-index-raised": "10",
      "z-index-sticky": "30",
      "z-index-header": "40",
      "z-index-scrim": "50",
      "z-index-overlay": "60",
      "z-index-anchored": "70",
      "z-index-toast": "80",
      "z-index-fullscreen": "90",
      "size-chip": "24px",
      "size-control-sm": "28px",
      "size-control-md": "32px",
      "size-control-lg": "36px",
      "size-touch": "40px",
      "size-fab": "48px",
      "text-caption": "0.75rem",
      "text-caption--line-height": "1.4",
      "text-body": "0.8125rem",
      "text-body--line-height": "1.5",
      "text-emphasis": "0.875rem",
      "text-emphasis--line-height": "1.5",
      "text-section": "1rem",
      "text-section--line-height": "1.3",
      "text-section--letter-spacing": "-0.01em",
      "text-title": "1.25rem",
      "text-title--line-height": "1.2",
      "text-title--letter-spacing": "-0.01em",
      "text-display": "1.5rem",
      "text-display--line-height": "1.2",
      "text-display--letter-spacing": "-0.01em"
    },
    "light": {
      "bg": "#ffffff",
      "bg-2": "#f7f8f8",
      "fg": "#0f1011",
      "fg-2": "oklch(0.6 0.012 264)",
      "text": "#0f1011",
      "text-2": "#666a71",
      "accent": "#5e6ad2",
      "on-accent": "#ffffff",
      "border": "color-mix(in oklab, var(--text) 10%, transparent)",
      "border-strong": "color-mix(in oklab, var(--text) 18%, transparent)",
      "control-edge": "color-mix(in oklab, var(--text) 48%, transparent)",
      "hover": "color-mix(in oklab, var(--text) 5%, transparent)",
      "stage": "color-mix(in oklab, var(--fg-2) 12%, var(--bg))",
      "ok": "#15803d",
      "warn": "#b45309",
      "err": "#dc2626",
      "id-1": "oklch(0.58 0.06 160)",
      "id-2": "oklch(0.6 0.07 40)",
      "id-3": "oklch(0.58 0.06 330)",
      "overlay-shadow": "0 8px 30px color-mix(in oklab, var(--text) 12%, transparent)"
    },
    "dark": {
      "bg": "#ffffff",
      "bg-2": "#f7f8f8",
      "fg": "#0f1011",
      "fg-2": "oklch(0.6 0.012 264)",
      "text": "#0f1011",
      "text-2": "#666a71",
      "accent": "#5e6ad2",
      "on-accent": "#ffffff",
      "border": "color-mix(in oklab, var(--text) 10%, transparent)",
      "border-strong": "color-mix(in oklab, var(--text) 18%, transparent)",
      "control-edge": "color-mix(in oklab, var(--text) 48%, transparent)",
      "hover": "color-mix(in oklab, var(--text) 5%, transparent)",
      "stage": "color-mix(in oklab, var(--fg-2) 12%, var(--bg))",
      "ok": "#15803d",
      "warn": "#b45309",
      "err": "#dc2626",
      "id-1": "oklch(0.58 0.06 160)",
      "id-2": "oklch(0.6 0.07 40)",
      "id-3": "oklch(0.58 0.06 330)",
      "overlay-shadow": "0 8px 30px color-mix(in oklab, var(--text) 12%, transparent)"
    }
  },
  "css": {
    ".lucide": {
      "stroke-width": "1.75"
    },
    ".hit-target": {
      "position": "relative"
    },
    ".hit-target::after": {
      "content": "\"\"",
      "position": "absolute",
      "left": "50%",
      "top": "50%",
      "width": "max(100%, 24px)",
      "height": "max(100%, 24px)",
      "transform": "translate(-50%, -50%)"
    },
    "@keyframes shimmer": {
      "from": {
        "transform": "translateX(-100%)"
      },
      "to": {
        "transform": "translateX(100%)"
      }
    }
  },
  "type": "registry:style"
}